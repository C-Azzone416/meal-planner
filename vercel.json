{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bash tools/feedback/postinstall.sh",
  "buildCommand": "npm run --prefix web build",
  "outputDirectory": "web/dist",
  "headers": [
    {
      "source": "/connect",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/incoming-drafts/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth-proxy/:path*",
      "destination": "/api/auth-proxy?path=:path*"
    },
    {
      "source": "/sign-in",
      "destination": "/index.html"
    },
    {
      "source": "/connect",
      "destination": "/index.html"
    },
    {
      "source": "/week",
      "destination": "/index.html"
    },
    {
      "source": "/recipes",
      "destination": "/index.html"
    },
    {
      "source": "/recipes/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/prep",
      "destination": "/index.html"
    },
    {
      "source": "/shopping",
      "destination": "/index.html"
    },
    {
      "source": "/drafts",
      "destination": "/index.html"
    },
    {
      "source": "/incoming-drafts",
      "destination": "/index.html"
    },
    {
      "source": "/incoming-drafts/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/cook",
      "destination": "/index.html"
    },
    {
      "source": "/house-rules",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/draft-pairings/index.go": {
      "architecture": "x86_64",
      "maxDuration": 15
    },
    "api/draft-pairings/poll/index.go": {
      "architecture": "x86_64",
      "maxDuration": 15
    },
    "api/**/*.go": {
      "architecture": "x86_64"
    }
  }
}
