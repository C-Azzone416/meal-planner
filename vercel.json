{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix web",
  "buildCommand": "npm run --prefix web build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/sign-in", "destination": "/index.html" },
    { "source": "/week", "destination": "/index.html" },
    { "source": "/recipes", "destination": "/index.html" },
    { "source": "/prep", "destination": "/index.html" },
    { "source": "/shopping", "destination": "/index.html" },
    { "source": "/drafts", "destination": "/index.html" },
    { "source": "/cook", "destination": "/index.html" },
    { "source": "/house-rules", "destination": "/index.html" }
  ]
}
