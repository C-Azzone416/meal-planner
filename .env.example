# Server-only provider endpoint. The browser receives the fixed same-origin proxy path.
NEON_AUTH_BASE_URL=https://auth-provider.example.invalid/auth

# Server-only membership, independent per environment. Store as a Secret.
AUTH_ALLOWED_EMAILS='["member-a@example.invalid","member-b@example.invalid"]'

# Legacy single-member alternative: remove AUTH_ALLOWED_EMAILS entirely to use it.
# AUTH_ALLOWED_EMAIL=authorized-user@example.invalid

# Required environment binding for the blocking webhook.
NEON_AUTH_ENDPOINT_ID=endpoint-id-from-provider
