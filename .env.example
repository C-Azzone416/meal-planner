# Public browser auth endpoint. Use the environment's Neon Auth URL.
NEON_AUTH_BASE_URL=https://auth-provider.example.invalid/auth

# Server-only exact identity policy. Configure a different value per environment.
AUTH_ALLOWED_EMAIL=authorized-user@example.invalid

# Required environment binding for the blocking webhook.
NEON_AUTH_ENDPOINT_ID=endpoint-id-from-provider
